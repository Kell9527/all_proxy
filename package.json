{
  "name": "all-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "all_proxy — 把 10 个 AI 平台账号聚合成标准 OpenAI / Anthropic 兼容 API 的本地网关（含网页管理端）",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:assets": "node scripts/copy-assets.mjs",
    "build:web": "vite build",
    "build:all": "npm run build && npm run build:assets && npm run build:web",
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "port:providers": "node scripts/port-providers.mjs --group adapters && node scripts/port-providers.mjs --group credentials",
    "port:tests": "node scripts/port-tests.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "jose": "^6.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
